{
  "name": "@wizzard-packages/core",
  "version": "0.4.1",
  "description": "Core logic for Wizzard Stepper - framework agnostic store and utilities.",
  "keywords": [
    "wizard",
    "stepper",
    "state-management",
    "headless",
    "workflow",
    "state-machine"
  ],
  "license": "MIT",
  "author": "ZizzX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZizzX/wizzard-packages.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./v1": {
      "import": {
        "types": "./dist/v1/index.d.ts",
        "default": "./dist/v1/index.js"
      },
      "require": {
        "types": "./dist/v1/index.d.cts",
        "default": "./dist/v1/index.cjs"
      }
    },
    "./validate-flow": {
      "import": {
        "types": "./dist/v1/validate-flow.d.ts",
        "default": "./dist/v1/validate-flow.js"
      },
      "require": {
        "types": "./dist/v1/validate-flow.d.cts",
        "default": "./dist/v1/validate-flow.cjs"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/v1/graph.d.ts",
        "default": "./dist/v1/graph.js"
      },
      "require": {
        "types": "./dist/v1/graph.d.cts",
        "default": "./dist/v1/graph.cjs"
      }
    },
    "./groups": {
      "import": {
        "types": "./dist/v1/groups.d.ts",
        "default": "./dist/v1/groups.js"
      },
      "require": {
        "types": "./dist/v1/groups.d.cts",
        "default": "./dist/v1/groups.cjs"
      }
    },
    "./session": {
      "import": {
        "types": "./dist/v1/session.d.ts",
        "default": "./dist/v1/session.js"
      },
      "require": {
        "types": "./dist/v1/session.d.cts",
        "default": "./dist/v1/session.cjs"
      }
    },
    "./snapshot": {
      "import": {
        "types": "./dist/v1/snapshot.d.ts",
        "default": "./dist/v1/snapshot.js"
      },
      "require": {
        "types": "./dist/v1/snapshot.d.cts",
        "default": "./dist/v1/snapshot.cjs"
      }
    },
    "./expr": {
      "import": {
        "types": "./dist/v1/expr-builder.d.ts",
        "default": "./dist/v1/expr-builder.js"
      },
      "require": {
        "types": "./dist/v1/expr-builder.d.cts",
        "default": "./dist/v1/expr-builder.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit -p src/v1/tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16",
    "yup": "^1.6.1",
    "zod": "^3.24.1"
  }
}
