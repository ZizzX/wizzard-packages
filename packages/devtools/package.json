{
  "name": "@wizzard-packages/devtools",
  "version": "2.0.1",
  "description": "DevTools UI for Wizzard Stepper.",
  "keywords": [
    "wizard",
    "stepper",
    "devtools",
    "react",
    "debug",
    "form"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZizzX/wizzard-packages.git",
    "directory": "packages/devtools"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless/index.d.ts",
        "default": "./dist/headless/index.js"
      },
      "require": {
        "types": "./dist/headless/index.d.cts",
        "default": "./dist/headless/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@wizzard-packages/core": "workspace:*",
    "@wizzard-packages/react": "workspace:*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@wizzard-packages/core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16",
    "@wizzard-packages/react": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@wizzard-packages/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
