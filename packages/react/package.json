{
  "name": "@wizzard-packages/react",
  "version": "0.4.0",
  "description": "React components and hooks for Wizzard Stepper.",
  "keywords": [
    "wizard",
    "stepper",
    "react",
    "form",
    "multi-step",
    "headless",
    "workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZizzX/wizzard-packages.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./v1": {
      "import": {
        "types": "./dist/v1/index.d.ts",
        "default": "./dist/v1/index.js"
      },
      "require": {
        "types": "./dist/v1/index.d.cts",
        "default": "./dist/v1/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@wizzard-packages/core": "workspace:*",
    "@wizzard-packages/middleware": "workspace:*",
    "@wizzard-packages/persistence": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
