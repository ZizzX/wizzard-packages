{
  "name": "@wizzard-packages/validate",
  "version": "0.1.1",
  "description": "One Standard Schema validation adapter for Wizzard flows — Zod, Valibot, ArkType, Effect and Yup.",
  "keywords": [
    "wizard",
    "stepper",
    "validation",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "effect",
    "yup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZizzX/wizzard-packages.git",
    "directory": "packages/validate"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@wizzard-packages/core": "workspace:*"
  },
  "devDependencies": {
    "arktype": "2.2.8",
    "effect": "4.0.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "valibot": "1.5.0",
    "vitest": "^4.0.16",
    "yup": "^1.7.1",
    "zod": "^4.2.1"
  }
}
