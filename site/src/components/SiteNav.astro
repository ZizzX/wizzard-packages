---
/**
 * The site's four destinations. The top bar carries them on every page; on a
 * phone the documentation's bar has no room, so they open with its menu
 * instead (`DocsSidebar.astro`).
 */
interface Props {
  /** Which entry is the page being read. The documentation is always "docs". */
  current?: 'examples' | 'inspector' | 'docs' | undefined;
  /**
   * A `<nav>` of its own. Off inside the documentation's menu, which is already
   * Starlight's "Main" navigation: a landmark inside a landmark is noise.
   */
  landmark?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Starlight's getter throws outside its own pages rather than returning nothing,
// and the not-found page is one of its routes but not part of the documentation.
const inDocs = (() => {
  try {
    return Astro.locals.starlightRoute.entry.id !== '404';
  } catch {
    return false;
  }
})();
const current = Astro.props.current ?? (inDocs ? 'docs' : undefined);
const links = [
  { href: `${base}/examples/`, label: 'Examples', key: 'examples' },
  { href: `${base}/inspector/`, label: 'Inspector', key: 'inspector' },
  { href: `${base}/docs/start/`, label: 'Docs', key: 'docs' },
  { href: 'https://github.com/ZizzX/wizzard-packages', label: 'GitHub' },
];
const Tag = Astro.props.landmark === false ? 'div' : 'nav';
---

<Tag class="site-nav" aria-label={Tag === 'nav' ? 'Site' : undefined}>
  {
    links.map(({ href, label, key }) => (
      <a
        href={href}
        aria-current={
          key && key === current ? (Astro.url.pathname === href ? 'page' : 'true') : undefined
        }
      >
        {label}
      </a>
    ))
  }
</Tag>
