{
  "name": "wizzard-packages",
  "private": true,
  "version": "0.1.0",
  "description": "Headless, typed, framework-agnostic engine for multi-step wizards and flows.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "pnpm test:run && pnpm test:e2e",
    "type-check": "turbo run type-check",
    "docs:api": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:ui": "pnpm --filter @wizzard-packages/ui dev",
    "docs:ui:build": "pnpm --filter @wizzard-packages/ui build",
    "changeset": "changeset",
    "release": "changeset version && pnpm install --lockfile-only",
    "release:publish": "changeset publish",
    "commit": "cz",
    "prepare": "husky || true",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "publint": "pnpm -r --filter \"./packages/*\" --filter \"!@wizzard-packages/ui\" exec publint",
    "attw": "pnpm -r --filter \"./packages/*\" --filter \"!@wizzard-packages/ui\" exec attw --pack . --profile node16",
    "check:pack": "pnpm publint && pnpm attw",
    "size:build": "pnpm build && pnpm size"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "wizard",
    "stepper",
    "multi-step",
    "form",
    "flow",
    "headless",
    "state-machine",
    "react",
    "vue",
    "typescript"
  ],
  "author": "Aziz Isapov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZizzX/wizzard-packages.git"
  },
  "bugs": {
    "url": "https://github.com/ZizzX/wizzard-packages/issues"
  },
  "homepage": "https://github.com/ZizzX/wizzard-packages#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "fast-check": "^4.9.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.7.4",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "yup": "^1.7.1",
    "zod": "^4.2.1"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.11"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
